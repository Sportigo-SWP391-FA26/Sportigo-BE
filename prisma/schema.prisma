enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlanAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

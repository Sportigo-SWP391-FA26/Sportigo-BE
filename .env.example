NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sport_center?schema=public
# Web service Render/local là tiến trình sống lâu nên dùng Supabase session pooler 5432.
# Nếu DATABASE_URL cũ còn là pooler 6543, runtime tự chuyển sang 5432; test vẫn giữ 6543.
# Chỉ đặt DB_POOL_MODE=transaction cho runtime serverless hoặc connection rất ngắn.
DB_POOL_MODE=session
# Prisma tự áp giới hạn an toàn bên dưới (runtime 8, test 4 nếu không cấu hình).
DB_CONNECTION_LIMIT=8
TEST_DB_CONNECTION_LIMIT=4
DB_POOL_TIMEOUT=10
# Database riêng cho integration test (tên phải chứa "test"; test sẽ xóa sạch dữ liệu).
# Bỏ trống thì integration test được bỏ qua.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sport_center_test?schema=public
# Chỉ bật khi TEST_DATABASE_URL trỏ tới database/schema test tách biệt trên remote.
ALLOW_REMOTE_TEST_DATABASE=false
# Chỉ bật khi schema test đã được migrate và pooler không hỗ trợ Prisma migrate.
TEST_DATABASE_MIGRATIONS_ALREADY_APPLIED=false
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Sportigo <no-reply@your-verified-domain.com>
# Số giờ sau khi buổi học kết thúc mà Coach vẫn được sửa điểm danh (FR-47)
ATTENDANCE_EDIT_WINDOW_HOURS=24
# Số giờ tối thiểu Member phải hủy trước buổi học đầu tiên (FR-28)
CLASS_CANCELLATION_CUTOFF_HOURS=48
GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GMAIL_WEBHOOK_SECRET=your-random-secret-at-least-32-characters
EMAIL_FROM=Sportigo <your-sportigo-account@gmail.com>
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/member/payments/result
VNPAY_IPN_URL=
